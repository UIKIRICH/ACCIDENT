# ============================================================================
# 事故处理平台 - 环境变量配置
# ============================================================================

# ---------------------------------------------------------------------------
# 数据库配置
# ---------------------------------------------------------------------------
# SQLite（默认）:
DATABASE_URL=sqlite:///./accident_platform.db

# MySQL（生产环境示例）:
# DATABASE_URL=mysql+pymysql://user:password@host:3306/accident_db

# ---------------------------------------------------------------------------
# Dify LLM 集成配置
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=/api

# Dify backend bridge config (read by backend/video_keyframe.py)
# Use your teammate's Dify service address, for example: `http://192.168.0.103`
DIFY_BASE_URL=https://xs1cb2320901.vicp.fun
# Fill this with the API key generated in Dify "API Access"
DIFY_API_KEY=app-KF7hZ8IGr7JV138JEonU8vqr
# Usually keep default; override only if your route is different
DIFY_WORKFLOW_ENDPOINT=/v1/workflows/run
DIFY_RESPONSE_MODE=blocking
DIFY_TIMEOUT_SEC=60
# This workflow expects `query` as required input.
DIFY_INPUT_SUMMARY_KEY=query
# Stabilize Dify inputs by stripping volatile fields (recommended for reproducible debug)
DIFY_STABILIZE_INPUTS=1
# Send compact JSON payload to Dify (recommended to reduce noise/randomness)
DIFY_COMPACT_JSON_INPUTS=0
# Include raw full JSON alongside stabilized JSON (usually keep 0 to avoid noisy prompts)
DIFY_INCLUDE_RAW_INPUTS=0
# Hash debug logging for Dify calls
DIFY_HASH_LOG_ENABLED=1
DIFY_HASH_LOG_FILE=outputs/dify_hash_logs.jsonl

DIFY_LOCAL_FALLBACK_ENABLED=true

# ---------------------------------------------------------------------------
# 千问（Qwen）视频分析 API 配置
