QWEN_API_KEY=sk-ws-H.RPXXPHH.BgLX.MEYCIQCmYWrlUmpstrG-hjjMzxxiENaNXXJKZmz1XBsUFKpM8AIhAMkaNbDNO37Z7B87H_DPnCnfvTPEdRRmY_eseexmVYnJ
QWEN_MODEL=qwen3.7-plus
QWEN_WS_ID=ws-8f0z6uatr9ls6ucg

VITE_EXTRACT_TIMEOUT_MS=180000

# ---------------------------------------------------------------------------
# 生产部署配置
# ---------------------------------------------------------------------------
# CORS 允许的来源（生产环境必须设置，多个用逗号分隔）
# 不设置则默认允许所有来源（仅适合开发环境）
CORS_ALLOW_ORIGINS=http://47.104.233.96,http://shiguzhu.cloud,https://shiguzhu.cloud

# 前端托管模式:
#   true  (默认) → FastAPI 直接托管 dist/ 静态文件（方案 B）
#   false        → 使用外部 Nginx 代理（方案 A，需配置 nginx.conf）
SERVE_STATIC=false

